@baseUrl = https://localhost:7259
@contentType = application/json

###
# Criar orçamento com sucesso
POST {{baseUrl}}/api/orcamentos/criar
Content-Type: {{contentType}}

{
  "clienteId": 10,
  "veiculoId": 25,
  "itens": [
    {
      "descricao": "Troca de óleo",
      "quantidade": 1,
      "valorUnitario": 120.00
    },
    {
      "descricao": "Filtro de óleo",
      "quantidade": 1,
      "valorUnitario": 45.00
    }
  ]
}

###
# Erro: ClienteId inválido
POST {{baseUrl}}/api/orcamentos/criar
Content-Type: {{contentType}}

{
  "clienteId": 0,
  "veiculoId": 25,
  "itens": [
    {
      "descricao": "Troca de óleo",
      "quantidade": 1,
      "valorUnitario": 120.00
    }
  ]
}

###
# Erro: VeiculoId inválido
POST {{baseUrl}}/api/orcamentos/criar
Content-Type: {{contentType}}

{
  "clienteId": 10,
  "veiculoId": -5,
  "itens": [
    {
      "descricao": "Troca de óleo",
      "quantidade": 1,
      "valorUnitario": 120.00
    }
  ]
}

###
# Erro: Sem itens
POST {{baseUrl}}/api/orcamentos/criar
Content-Type: {{contentType}}

{
  "clienteId": 10,
  "veiculoId": 25,
  "itens": []
}

###
# Erro: Item com descrição vazia
POST {{baseUrl}}/api/orcamentos/criar
Content-Type: {{contentType}}

{
  "clienteId": 10,
  "veiculoId": 25,
  "itens": [
    {
      "descricao": "",
      "quantidade": 1,
      "valorUnitario": 120.00
    }
  ]
}

###
# Erro: Item com quantidade inválida
