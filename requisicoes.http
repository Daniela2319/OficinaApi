###
# Erro: Múltiplos erros de validação
POST {{baseUrl}}/api/orcamentos/criar
Content-Type: {{contentType}}

{
  "clienteId": -1,
  "veiculoId": 0,
  "itens": [
    {
      "descricao": "",
      "quantidade": -2,
      "valorUnitario": 0
    },
    {
      "descricao": "Serviço B",
      "quantidade": 0,
      "valorUnitario": -100
    }
  ]
}

###
# Orçamento com múltiplos itens
POST {{baseUrl}}/api/orcamentos/criar
Content-Type: {{contentType}}

{
  "clienteId": 15,
  "veiculoId": 30,
  "itens": [
    {
      "descricao": "Troca de óleo",
      "quantidade": 1,
      "valorUnitario": 120.00
    },
    {
      "descricao": "Filtro de ar",
      "quantidade": 2,
      "valorUnitario": 35.50
    },
    {
      "descricao": "Limpeza de freio",
      "quantidade": 1,
      "valorUnitario": 200.00
    }
  ]
}

###
# Orçamento com quantidade decimal
POST {{baseUrl}}/api/orcamentos/criar
Content-Type: {{contentType}}

{
  "clienteId": 20,
  "veiculoId": 40,
  "itens": [
    {
      "descricao": "Serviço por hora",
      "quantidade": 2.5,
      "valorUnitario": 150.00
    }
  ]
}
